# نسخ من هذا الملف إلى .env واملأ القيم الحقيقية (لا تُرفع الأسرار إلى git)

# اتصال PostgreSQL (Neon) — للبيئة المباشرة
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# سر توقيع جلسات الأدمن (غيّره لقيمة عشوائية طويلة)
AUTH_SECRET="change-me-to-a-long-random-string"

# Cloudinary للصور
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_URL="cloudinary://your-api-key:your-api-secret@your-cloud-name"

# كلمة مرور الأدمن عند البذر (اختياري — default: SalamAdmin@2026)
SEED_ADMIN_PASSWORD="SalamAdmin@2026"
